<%- include('partials/head', { title: 'Empresas e órgãos' }) %>
<section class="page-header">
  <div class="container narrow">
    <span class="eyebrow">Histórico público</span>
    <h1>Empresas e órgãos</h1>
    <p>Pesquise pelo nome e município para consultar reclamações, respostas e histórico.</p>
    <form class="filter-bar" action="/empresas" method="get">
      <div class="filter-grow">
        <label for="company-q">Nome da empresa ou órgão</label>
        <input id="company-q" name="q" value="<%= query %>" placeholder="Digite o nome">
      </div>
      <div>
        <label for="company-city">Município</label>
        <select id="company-city" name="municipio">
          <option value="">Todos os municípios</option>
          <% municipalities.forEach((municipality) => { %>
            <option value="<%= municipality.id %>" <%= selectedMunicipality === municipality.id ? 'selected' : '' %>><%= municipality.name %>/<%= municipality.state %></option>
          <% }) %>
        </select>
      </div>
      <button class="button button-dark" type="submit">Pesquisar</button>
    </form>
  </div>
</section>
<section class="section">
  <div class="container narrow">
    <div class="result-line"><strong><%= companies.length %></strong> resultado(s) encontrado(s)</div>
    <% if (!companies.length) { %>
      <div class="empty-state"><span>⌕</span><h2>Nenhuma entidade encontrada</h2><p>Tente outro nome ou município.</p></div>
    <% } %>
    <div class="company-list">
      <% companies.forEach((company) => { %>
        <article class="company-card">
          <div class="company-avatar"><%= company.name.slice(0, 2).toUpperCase() %></div>
          <div class="company-card-body">
            <h2><a href="/empresas/<%= company.slug %>"><%= company.name %></a></h2>
            <p>📍 <%= company.municipality_name %>/<%= company.state %></p>
            <span><strong><%= company.complaint_count %></strong> reclamações no histórico</span>
          </div>
          <a class="button button-outline" href="/empresas/<%= company.slug %>">Ver página →</a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>