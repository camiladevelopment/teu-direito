<%- include('partials/head', { title: 'Entrar' }) %>
<section class="auth-page">
  <div class="container auth-layout auth-layout-small">
    <div class="auth-intro">
      <span class="eyebrow eyebrow-light">Bem-vindo de volta</span>
      <h1>Sua participação faz diferença.</h1>
      <p>Acompanhe relatos, respostas e causas apoiadas por você.</p>
    </div>
    <div class="auth-card">
      <h2>Entrar na sua conta</h2>
      <form action="/entrar" method="post" class="main-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="login-email">E-mail</label>
          <input id="login-email" type="email" name="email" required autocomplete="email">
        </div>
        <div class="field">
          <label for="login-password">Senha</label>
          <input id="login-password" type="password" name="password" required autocomplete="current-password">
        </div>
        <button class="button button-primary button-large button-block" type="submit">Entrar</button>
      </form>
      <div class="demo-box">
        <strong>Experimente com dados de demonstração</strong>
        <span>Trabalhador: trabalhador@demo.local</span>
        <span>Empresa: empresa@demo.local</span>
        <span>Senha: Demo@123</span>
      </div>
      <p class="auth-switch">Ainda não tem conta? <a href="/cadastro">Cadastre-se gratuitamente</a></p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>