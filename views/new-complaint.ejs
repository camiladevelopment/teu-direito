<%- include('partials/head', { title: 'Relatar um problema' }) %>
<section class="form-page">
  <div class="container form-container">
    <a class="back-link" href="/reclamacoes">← Voltar para reclamações</a>
    <div class="form-heading">
      <span class="eyebrow">Sua experiência importa</span>
      <h1>Relate um problema</h1>
      <p>Comece pelo que aconteceu. Você poderá acompanhar respostas e publicar uma réplica.</p>
    </div>
    <% if (errors.length) { %>
      <div class="validation-box" role="alert">
        <strong>Revise os dados:</strong>
        <ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <form action="/reclamacoes" method="post" class="main-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset>
        <legend><span>1</span> O que aconteceu?</legend>
        <div class="field">
          <label for="title">Título do relato</label>
          <input id="title" name="title" required minlength="8" maxlength="140" value="<%= values.title || '' %>" placeholder="Resuma o problema de forma objetiva">
          <small>Não inclua dados pessoais no título.</small>
        </div>
        <div class="field">
          <label for="description">Descrição do problema</label>
          <textarea id="description" name="description" required minlength="30" maxlength="5000" rows="8" data-counter="description-count" placeholder="Conte quando começou, como você foi afetado e quais providências já tentou."><%= values.description || '' %></textarea>
          <small id="description-count">Até 5.000 caracteres. Evite CPF, telefone, endereço ou outros dados sensíveis.</small>
        </div>
      </fieldset>
      <fieldset>
        <legend><span>2</span> Onde e sobre qual assunto?</legend>
        <div class="form-row">
          <div class="field">
            <label for="state">Estado (UF)</label>
            <select id="state" name="state" required data-state-selector>
              <option value="">Selecione</option>
              <% states.forEach((state) => { %>
                <option value="<%= state.code %>" <%= values.state === state.code ? 'selected' : '' %>><%= state.name %> (<%= state.code %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="category">Categoria</label>
            <select id="category" name="category_id" required>
              <option value="">Selecione</option>
              <% categories.forEach((category) => { %>
                <option value="<%= category.id %>" <%= Number(values.category_id) === category.id ? 'selected' : '' %>><%= category.icon %> <%= category.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="municipality">Município</label>
          <input id="municipality" name="municipality_name" list="municipality-suggestions" required minlength="2" maxlength="120" value="<%= values.municipality_name || '' %>" placeholder="Primeiro selecione o estado" autocomplete="address-level2" disabled data-municipality-input>
          <datalist id="municipality-suggestions"></datalist>
          <small id="municipality-help" data-municipality-help>Selecione o estado para carregar todos os municípios brasileiros daquela UF.</small>
        </div>
      </fieldset>
      <fieldset>
        <legend><span>3</span> Quem está envolvido?</legend>
        <p class="field-help">Escreva o nome correto da empresa, órgão público ou entidade responsável. Não é necessário selecionar opções.</p>
        <div class="field">
          <label for="entity-name">Nome da empresa, órgão ou entidade</label>
          <input id="entity-name" name="entity_name" list="company-suggestions" required minlength="3" maxlength="150" value="<%= values.entity_name || '' %>" placeholder="Ex.: Empresa Exemplo Ltda. ou Prefeitura de ..." autocomplete="organization">
          <datalist id="company-suggestions">
          <% companies.forEach((company) => { %>
            <option value="<%= company.name %>"><%= company.municipality_name %>/<%= company.state %></option>
          <% }) %>
          </datalist>
          <small>Use o nome oficial, sem apelidos, ofensas ou palavrões. Se ainda não estiver cadastrada, a entidade será incluída para receber o relato.</small>
        </div>
      </fieldset>
      <div class="privacy-note"><span>🛡️</span><p><strong>Antes de publicar</strong> Seu nome aparecerá como autor, mas seu e-mail nunca será exibido. Revise o texto, remova dados pessoais de terceiros e mantenha uma linguagem respeitosa.</p></div>
      <button class="button button-primary button-large button-block" type="submit">Publicar reclamação →</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>